# Protect configuration and logs from direct web access (Apache 2.4).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # The app is moving to a custom domain. Keep the old alwaysdata hostname alive by
    # permanently redirecting it to the canonical domain, preserving path and query
    # string. This must come before the HTTPS rule below so the redirect target is the
    # new domain rather than the old host over HTTPS.
    RewriteCond %{HTTP_HOST} ^glucocare\.alwaysdata\.net$ [NC]
    RewriteRule ^(.*)$ https://glucocare.online/$1 [R=301,L]

    # Force HTTPS in production. TLS terminates at alwaysdata's proxy, so %{HTTPS} is
    # not set even for real https requests; the proxy's X-Forwarded-Proto header is the
    # reliable signal (absent for plain http). Loopback hosts are exempt so local
    # XAMPP development stays on plain http.
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Runtime data and server-side code: never served over HTTP.
    RewriteRule ^(logs|backups|bin|config|database|includes|tests)/ - [F,L]
    # Version-control metadata and dotfiles. The app is deployed by `git clone` into the web root,
    # so .git/ (history, config) must never be readable over HTTP.
    RewriteRule (^|/)\.(git|svn|hg|env) - [F,L]
</IfModule>
