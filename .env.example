[TEMPLATE]
# Copy to .env and adjust. Never commit the real .env file.
APP_DEBUG=0

# --- Database: Supabase (PostgreSQL) ---
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the "Session pooler" string: it works on IPv4-only networks.
#   Pooler host : aws-0-<region>.pooler.supabase.com
#   Pooler port : 6543
#   Pooler user : postgres.<project-ref>
#   Database    : postgres
#   Password    : the project's database password (not your Supabase account password)
# Direct connections (port 5432, no pooler) need IPv6 or Supabase's IPv4 add-on.
CDSS_DB=postgres
# DB_NAME is accepted as a legacy alias for CDSS_DB — leave it unset.
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.<project-ref>
DB_PASS=
# require = TLS, enforced by Supabase. Set disable only for a local PostgreSQL server.
DB_SSL=require

# --- Alert digest email ---
# log = write .eml files to logs/mail (development, no credentials); smtp = real delivery
MAIL_DRIVER=log
MAIL_FROM=alerts@example.test
MAIL_FROM_NAME="GlucoCare Alerts"
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_SMTP_SECURE=tls
# Critical alerts older than this many hours are emailed to the assigned clinician
DIGEST_AFTER_HOURS=4
# Absolute URL used for links in emails, e.g. https://cdss.example.org
APP_URL=

# --- Patient SMS ---
# log = write .txt files to logs/sms (works offline); http = POST JSON to a gateway; none = off
SMS_DRIVER=log
SMS_HTTP_URL=
SMS_HTTP_TOKEN=

# --- Session and automation health ---
# Sign a user out after this many minutes without a request
SESSION_IDLE_MINUTES=45
# Warn on the admin overview if the engine scan/digest has not run in this many hours
SCAN_STALE_HOURS=26

# --- Backups (bin/backup.php) ---
# Path to pg_dump. Leave empty to let the script look in PATH and the usual install folders.
# pg_dump must match (or be newer than) the Supabase Postgres major version.
PGDUMP_PATH=
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14
